# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
# docker compose passes this into the API container at run time. The image does not contain it.
ASPNETCORE_ENVIRONMENT=Development

# HMAC key for signing JWTs. At least 32 characters. This value is a local fixture.
# A real deployment sets its own and does not reuse it. Tokens last 8 hours (480 minutes).
# docker compose passes these into the API container. They are not copied into the image.
Jwt__Issuer=SupportDesk
Jwt__Audience=SupportDesk
Jwt__SigningKey=local-dev-only-signing-key-not-a-secret-01
Jwt__LifetimeMinutes=480

# --- Dockerised API --------------------------------------------------------
# `docker compose up --build` publishes the API at http://localhost:5080.
# Inside the container, ConnectionStrings__Default uses host `sqlserver` (the
# compose service name) and MSSQL_SA_PASSWORD from above. The localhost
# connection string in this file is only for `npm run api` on the host.
# Point the web dev server at the container with:
#   VITE_API_PROXY_TARGET=http://localhost:5080 npm run web
